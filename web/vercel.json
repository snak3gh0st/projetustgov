{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/bitrix-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 22 * * *"
    }
  ]
}
