{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/sync-leads",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/sync-execucao",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/cron/sync-tgov-only",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "20 14 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 22 * * *"
    }
  ]
}
