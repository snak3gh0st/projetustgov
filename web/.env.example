# Database
DATABASE_URL=postgresql://user:pass@host:port/database
POSTGRES_URL=postgresql://user:pass@host:port/database

# Auth.js
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: For Vercel deployment, NEXTAUTH_SECRET must be set in Vercel environment variables
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000
