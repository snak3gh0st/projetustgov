# Database
DATABASE_URL=postgresql://user:pass@host:port/database
POSTGRES_URL=postgresql://user:pass@host:port/database

# Auth.js
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: For Vercel deployment, NEXTAUTH_SECRET must be set in Vercel environment variables
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# Conta Azul OAuth (API v2)
# Generate encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REDIRECT_URI=https://projete.sigmaintel.io/api/integrations/conta-azul/callback
CONTA_AZUL_TOKEN_ENCRYPTION_KEY=
CONTA_AZUL_TENANT_KEY=projetus
