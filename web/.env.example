# Database
DATABASE_URL=postgresql://user:pass@host:port/database
POSTGRES_URL=postgresql://user:pass@host:port/database

# Auth.js
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: For Vercel deployment, NEXTAUTH_SECRET must be set in Vercel environment variables
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# Bitrix24 outbound sync
# Use the incoming webhook base URL, without appending the method name.
# Example: https://your-company.bitrix24.com.br/rest/1/xxxxxxxxxxxx
BITRIX_WEBHOOK_URL=

# Optional: force all created/updated deals to a specific Bitrix user owner.
BITRIX_DEFAULT_ASSIGNED_BY_ID=

# Required in Vercel so the scheduled Bitrix queue drain can authenticate.
CRON_SECRET=replace-with-a-random-secret
