# Conexão direta ao Postgres em sigmadb (NÃO usar o .env.production do Vercel — aquele URL é Supabase/pooler da app hospedada).
#
# Copie para um ficheiro local não versionado, por exemplo:
#   cp .env.sigmadb.example .env.sigmadb.local
# e preencha a URL real.
#
# Com túnel SSH (PostgreSQL só escuta em localhost no servidor):
#   ssh -N -L 54333:127.0.0.1:5432 seu_usuario@sigmadb
# Depois use host 127.0.0.1 e porta 54333 aqui em baixo.

DATABASE_SIGMADB_URL="postgresql://USUARIO:SENHA@127.0.0.1:54333/NOME_DATABASE"
